{
  "name": "pixel-war-live",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node test/game.test.js && node test/energy.test.js && node test/tiktok.test.js && node test/connection.test.js && node test/rounds.test.js && node test/persistence.test.js && node test/formations.test.js && node test/hud.test.js && node test/gifts.test.js && node test/async-storage.test.js",
    "build": "npm run build:assets && npm run build:3d",
    "prestart": "npm run build",
    "predev": "npm run build",
    "build:3d": "tsc -p tsconfig.json && vite build",
    "dev:3d": "vite",
    "typecheck": "tsc -p tsconfig.json",
    "test:3d": "npm run build && node tools/three-check.mjs",
    "test:models": "npm run build && node tools/model-check.mjs",
    "test:battlefield": "npm run build && node tools/battlefield-check.mjs",
    "test:fortresses": "npm run build && node tools/fortress-check.mjs",
    "test:hud": "npm run build && node tools/hud-check.mjs",
    "build:assets": "python3 tools/extract-ui-kit.py && node tools/build.mjs && python3 tools/extract-kaykit.py && python3 tools/validate-kaykit.py",
    "test:browser": "npm run build && node tools/gameplay-check.mjs",
    "test:audio": "node tools/audio-check.mjs",
    "audio:generate": "python3 tools/make-audio.py",
    "test:terrain": "npm run build && node tools/terrain-check.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "socket.io": "^4.8.1",
    "three": "^0.180.0",
    "tiktok-live-connector": "2.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/three": "^0.180.0",
    "prettier": "^3.9.10",
    "socket.io-client": "^4.8.1",
    "typescript": "~5.9.2",
    "vite": "^6.4.5"
  }
}
